# Finance RAG — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# OpenAI
# =============================================================================

# Your OpenAI API key (required for generation, grading, decomposition, and Ragas evals)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model used for generation, sufficiency grading, and hallucination guard (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# =============================================================================
# Qdrant Vector Database
# =============================================================================

# URL of your Qdrant instance (default: local Docker on port 6333)
QDRANT_URL=http://localhost:6333

# Qdrant API key — only needed for Qdrant Cloud; leave blank for local Docker
QDRANT_API_KEY=

# Name of the Qdrant collection storing SEC filing chunks
QDRANT_COLLECTION=sec_filings

# =============================================================================
# Embedding Model
# =============================================================================

# BGE-M3 model identifier (downloaded from HuggingFace at runtime)
EMBEDDING_MODEL=BAAI/bge-m3

# Dense embedding dimension (must match the model; BGE-M3 default: 1024)
EMBEDDING_DIM=1024

# Use FP16 for the embedding model (reduces VRAM/RAM usage; set false on CPU-only machines)
USE_FP16=true

# =============================================================================
# Cross-Encoder Reranker
# =============================================================================

# Reranker model identifier (downloaded from HuggingFace at runtime)
RERANKER_MODEL=BAAI/bge-reranker-large

# =============================================================================
# Retrieval
# =============================================================================

# Number of candidate chunks returned by hybrid search before reranking
RETRIEVAL_TOP_K=25

# Top-K chunks kept after reranking (default, single-entity/single-year queries)
RERANK_TOP_K=5

# Top-K chunks kept after reranking for multi-entity or multi-year queries
RERANK_TOP_K_EXPANDED=8

# =============================================================================
# CRAG (Corrective RAG)
# =============================================================================

# Maximum number of query-rewrite cycles before issuing an explicit refusal
MAX_CRAG_CYCLES=2

# Coarse gate threshold: if the top reranker score is below this value,
# abstain immediately without calling the LLM (saves API cost on irretrievable queries)
RERANKER_COARSE_THRESHOLD=-2.0

# =============================================================================
# Chunking
# =============================================================================

# Target size for prose chunks in tokens
PROSE_CHUNK_SIZE=512

# Overlap ratio between adjacent prose chunks (0.0–1.0)
PROSE_CHUNK_OVERLAP=0.1

# Maximum tokens before a table chunk is split into child chunks
MAX_TABLE_CHUNK_TOKENS=2048

# =============================================================================
# SEC EDGAR User-Agent
# Required by EDGAR fair-use policy: https://www.sec.gov/developer
# =============================================================================

# Your company or project name (included in the HTTP User-Agent header sent to EDGAR)
SEC_USER_AGENT_COMPANY=FinanceRAG

# Your contact email (EDGAR requires a valid email in the User-Agent header)
SEC_USER_AGENT_EMAIL=your.email@example.com

# =============================================================================
# Cost / Budget Guardrails
# =============================================================================

# Maximum USD cost allowed for a single interactive query
BUDGET_PER_QUERY=0.10

# Maximum USD cost allowed for a full evaluation run
BUDGET_PER_EVAL_RUN=50.0
