# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sec_filings

# === Embedding ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
USE_FP16=true

# === Reranker ===
RERANKER_MODEL=BAAI/bge-reranker-large

# === Retrieval ===
RETRIEVAL_TOP_K=25
RERANK_TOP_K=5
RERANK_TOP_K_EXPANDED=8

# === CRAG ===
MAX_CRAG_CYCLES=2

# === Chunking ===
PROSE_CHUNK_SIZE=512
PROSE_CHUNK_OVERLAP=0.1
MAX_TABLE_CHUNK_TOKENS=2048

# === SEC EDGAR ===
SEC_USER_AGENT_COMPANY=FinanceRAG
SEC_USER_AGENT_EMAIL=your.email@example.com

# === Cost Tracking ===
BUDGET_PER_QUERY=0.10
BUDGET_PER_EVAL_RUN=50.0
